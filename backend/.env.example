# ===========================================
# Configuration de l'API Assembly
# ===========================================
# Variables d'environnement — copiez ce fichier en .env et adaptez les valeurs

# Environnement
NODE_ENV=development
PORT=4000

# Base de données PostgreSQL (Supabase ou local)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assembly_db?schema=public"

# JWT
JWT_SECRET="changez-cette-cle-secrete-en-production-avec-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="7d"

# CORS — origines autorisées (séparées par virgule)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Application
APP_NAME="Assembly Management API"
APP_VERSION="1.0.0"
